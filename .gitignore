# easyeda2kicad API response cache
.easyeda_cache/

# Python
__pycache__/
*.pyc
.jlc_cache.json

# VS Code Local History extension
.history/

# KiCad archive exports and generated reports.
# kicad-cli writes its report next to the CWD, not next to the board, so the
# repo root needs the same patterns as hardware/.
hardware/*.zip
mixxtape_*.zip
*-erc.rpt
*-drc.rpt
hardware/scripts/*.net

# the full-resolution turntable render, kept locally but too heavy to commit
artwork/mixxtape-original.gif

# JLCPCB export working files (regenerate with hardware/scripts/export_fab.py)
fab/jlcpcb/gerbers/
