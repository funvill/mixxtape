	(gr_text "Outline traced from Open Music Labs Mixtape Alpha released" (at 34.000 104.700 0) (layer "Cmts.User")
		(uuid "33aad635-e232-4a15-b3b3-65373c1e7301")
		(effects (font (size 1.0 1.0) (thickness 0.2)) (justify left))
	)
	(gr_text "gerbers. Their wiki states no licence for the design files;" (at 34.000 106.900 0) (layer "Cmts.User")
		(uuid "72507488-857b-40d9-9073-7b951581b577")
		(effects (font (size 1.0 1.0) (thickness 0.2)) (justify left))
	)
	(gr_text "confirm with them before distributing derived artwork. The shape" (at 34.000 109.100 0) (layer "Cmts.User")
		(uuid "06002baf-93fb-4137-880e-2ea6f7f066ad")
		(effects (font (size 1.0 1.0) (thickness 0.2)) (justify left))
	)
	(gr_text "is the compact-cassette form factor, so redrawing it from a" (at 34.000 111.300 0) (layer "Cmts.User")
		(uuid "4074675b-e46b-4edc-a52a-1bc5108dc786")
		(effects (font (size 1.0 1.0) (thickness 0.2)) (justify left))
	)
	(gr_text "measured cassette is a straightforward fallback." (at 34.000 113.500 0) (layer "Cmts.User")
